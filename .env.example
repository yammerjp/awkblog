OAUTH_MOCK_PORT=8701
OAUTH_CLIENT_ID=clientkey
OAUTH_CLIENT_SECRET=clientsecret
OAUTH_CALLBACK_URI=http://localhost:8700/oauth-callback
AWKBLOG_PORT=8700
AWKBLOG_WORKERS=40
AWKBLOG_LANG=en
AWKBLOG_HOSTNAME=http://localhost8700
GITHUB_LOGIN_SERVER=http://localhost:8701
GITHUB_API_SERVER=http://localhost:8701
GITHUB_LOGIN_SERVER_INTERNAL=http://oauth-mock:8701
GITHUB_API_SERVER_INTERNAL=http://oauth-mock:8701
# Garage S3 ports (adjust per worktree: alice=891X, bob=892X, charlie=893X)
GARAGE_S3_PORT=8702
GARAGE_RPC_PORT=8703
GARAGE_WEB_PORT=8704
GARAGE_ADMIN_PORT=8705
S3_PROXY_PORT=8706
# S3 Storage Settings (Garage for local dev, or AWS S3 for production)
# Set NOT_USE_AWS_S3=1 to disable S3, remove it to enable
# NOT_USE_AWS_S3=1
AWS_ACCESS_KEY_ID=GK0123456789abcdef01234567
AWS_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AWS_BUCKET=awkblog-images
AWS_REGION=garage
S3_BUCKET_ENDPOINT=http://garage:8702
S3_ASSET_HOST=http://localhost:${S3_PROXY_PORT}
