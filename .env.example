OAUTH_MOCK_PORT=8701
OAUTH_CLIENT_ID=clientkey
OAUTH_CLIENT_SECRET=clientsecret
OAUTH_CALLBACK_URI=http://localhost:8700/oauth-callback
AWKBLOG_PORT=8700
AWKBLOG_WORKERS=40
AWKBLOG_LANG=en
AWKBLOG_HOSTNAME=http://localhost8700
GITHUB_LOGIN_SERVER=http://localhost:8701
GITHUB_API_SERVER=http://localhost:8701
GITHUB_LOGIN_SERVER_INTERNAL=http://oauth-mock:8701
GITHUB_API_SERVER_INTERNAL=http://oauth-mock:8701
# S3 Storage Settings
# Set NOT_USE_AWS_S3=1 to disable S3 features, remove it to enable
NOT_USE_AWS_S3=1
# AWS_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AWS_BUCKET=your-bucket-name
# AWS_REGION=ap-northeast-1
# S3_BUCKET_ENDPOINT=https://your-bucket-name.s3.ap-northeast-1.amazonaws.com
# S3_UPLOAD_ENDPOINT=https://your-bucket-name.s3.ap-northeast-1.amazonaws.com
# S3_ASSET_HOST=https://your-cloudfront-domain.cloudfront.net
